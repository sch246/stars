# 星罗的设置 —— 默认值。这个文件本身就是设置表单的 schema(LLF + 类型标签,见 DESIGN.md):
#   结构与默认值来自这里;控件来自标签:!bool 开关、!range(最小,最大,步长[,最小值时显示的文字]) 滑条、
#   !choice(值=显示名,…) 分段按钮;每一项上方紧挨着的注释,第一行是名字,其余是提示。
# 你的修改写在 ~/.config/stars/settings.llf(只记改过的项,结构与这里相同),不要改这个文件。
#
# 显示
display {}
  # 背景
  # 远方的星系 / 只有星点 / 纯黑(B)
  bg !choice(galaxy=星系,dots=星点,none=无) - galaxy
  # 文件夹边界
  # 文件夹的虚线边界与半透明底(视图规则 space.boundary=false 也会关)
  bounds !bool - true
  # 跟随选中
  # 选中节点后镜头跟住它:它钉在屏幕中央,外面的世界绕着它转;关掉则自由平移缩放
  follow !bool - true
  # 高亮选中
  # 选中后其它节点变暗,选中的、它的邻居、以及它展开出来的内容保持明亮;关掉则一律不变暗
  highlight !bool - true
  # 淡入淡出
  # 空间内外切换时的交叉淡入淡出;关掉则瞬间切换,更干脆
  fade !bool - true
# 运动
motion {}
  # 保持热量
  # 模拟始终保持一点温度:一直在缓慢运动,对拖动和变化立刻有反应;关掉则静止后停算(省电)
  heat !bool - true
  # 热量
  # 温度越高越活跃;太高会抖
  heatLevel !range(0.005,0.12,0.005) - 0.03
  # 公转
  # 子节点绕所在空间/父节点公转的速度(视图里 contains 的 spin 再乘这个倍率)
  spin !range(0,4,0.05) - 1
  # 斥力
  # 节点之间互相推开的力
  charge !range(0.2,4,0.05) - 1
  # 引力
  # 把节点拉向空间中心
  gravity !range(0,4,0.05) - 1
  # 连线长度
  # 有关系的节点之间的距离
  link !range(0.3,3,0.05) - 1
# 手感
feel {}
  # 拖动力
  # 拖动时把节点拉向指针的力度(1 = 原来的手感,默认 0.2);锁定拖动会持续施力,太大就会一直加速飞走
  dragForce !range(0,2,0.05) - 0.2
  # 疆域张力
  # 就地展开的空间的一圈软边界:成员超出自然疆域 E0 越多,被拉回的力越大。它同时决定:①软边界有多硬 ②拖成员时整组能分到多少拖动力(越大越早跟着指针走) ③松手后回弹多快。0 = 关闭(拖动会把疆域撑大,松手也不还原)
  tether !range(0,3,0.05) - 0.8
  # 收缩余量
  # 整组最多能收缩多少(上限):成员在自己的空间里最多伸到 E0×(1+余量),其余成员最多缩到 ≈ 1/(1+余量)。余量越大,整组跟着指针走之前能收缩得越深;实际深度还受「疆域张力」影响(张力越小缩得越深)。0 = 不收缩
  shrink !range(0,6,0.05) - 3
  # 进入空间
  # 放大到容器占屏幕短边的多少比例时进入它;0 = 跟随视图的设置(默认 0.42)
  enterAt !range(0,2,0.01,跟随视图) - 0
# 体积
volume {}
  # 真实体积
  # 目录和文件用同一套体积公式;占用与展开都不撑大,内容等比缩小;要看清就滚轮放大
  compact !bool - true
  # 体积映射
  # 真实体积开启时,字节数 → 半径 的缩放;sqrt 让面积 ∝ 体积,log 更紧凑
  volMap !choice(log,sqrt,linear) - sqrt
  # 体积下限
  # 真实体积映射后最小节点的半径
  volMin !range(0,40,0.5) - 2
  # 体积上限
  # 真实体积映射后最大节点的半径
  volMax !range(1,80,0.5) - 16
# 文件预览
preview {}
  # Markdown 渲染 HTML
  # 新打开的 Markdown 预览默认把里面的原始 HTML 也渲染出来(先清理掉脚本、iframe、事件属性等);每个预览上还能单独开关
  mdHtml !bool - true
  # HTML 允许脚本
  # 新打开的 HTML 预览默认运行 JavaScript(在沙箱里,碰不到查看器本身);每个预览上还能单独开关
  htmlScripts !bool - false
  # HTML 实时预览
  # 新打开的 HTML 预览默认跟着编辑器里还没保存的改动走(像 VS Code 的 Live Preview);关掉则只显示保存了的版本
  htmlLive !bool - true
# 高级
advanced !folded {}
  # 间隙 px
  # 碰撞时节点之间至少留的空隙
  gap !range(0,24,1) - 3
  # 阻尼
  # 越大停得越快、越不飘
  friction !range(0.1,0.8,0.01) - 0.42
--LLF-END
